{
  "name": "idbridge-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:ui": "node scripts/check-ui-baseline.mjs",
    "test:unit": "node --test src/lib/*.test.mjs src/portal/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run test:unit && npm run typecheck && npm run check:ui && npm run build"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "antd": "^5.29.3",
    "i18next": "^26.3.4",
    "lucide-react": "^0.468.0",
    "open-avatar": "^0.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.8.3"
  }
}
